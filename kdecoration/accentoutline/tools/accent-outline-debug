#!/usr/bin/env bash
# Read-only diagnostics for the Accent Outline KDecoration3 plugin.
#
# Exits non-zero if any check fails, so it is usable from a health check or a
# pre-reload guard. Every check here corresponds to a failure that was silent
# at the time: Qt cannot expand %h in QT_PLUGIN_PATH, kcmshell6 cannot resolve
# a bare decoration KCM id, and leaked ksecretd helpers pin logind sessions in
# "closing" until the next compositor start blocks forever.
set -u

plugin_id="io.github.towgenik.accentoutline"
plugin_root="$HOME/.local/lib/qt6/plugins"
plugin_dir="$plugin_root/org.kde.kdecoration3"
plugin_file="$plugin_dir/$plugin_id.so"
kcm_namespace="org.kde.kdecoration3.kcm"
kcm_id="kcm_accentoutline"
kcm_file="$plugin_root/$kcm_namespace/$kcm_id.so"
kcm_dropin="$HOME/.config/environment.d/90-kde-user-qt-plugins.conf"

failures=0
warnings=0

section() { printf '\n== %s ==\n' "$1"; }
ok() { printf '  [ ok ] %s\n' "$1"; }
warn() {
    printf '  [WARN] %s\n' "$1"
    warnings=$((warnings + 1))
}
bad() {
    printf '  [FAIL] %s\n' "$1"
    failures=$((failures + 1))
}
hint() { printf '         %s\n' "$1"; }

read_outline_entry() {
    local value
    value=$(kreadconfig6 --file accentoutlinerc --group Common --key "$1" 2>/dev/null || true)
    printf '%s' "${value:-$2}"
}

# ---------------------------------------------------------------- installed files
section "Files"
for f in "$plugin_file" "$kcm_file"; do
    if [ -f "$f" ]; then
        ok "$f"
        stat -c '         size=%s mode=%A modified=%y' "$f"
    else
        bad "missing: $f"
    fi
done

# ------------------------------------------------------------------ configuration
section "Configuration"
printf 'kwinrc library: %s\n' "$(kreadconfig6 --file kwinrc --group org.kde.kdecoration2 --key library 2>/dev/null || echo '<unavailable>')"
printf 'kwinrc theme:   %s\n' "$(kreadconfig6 --file kwinrc --group org.kde.kdecoration2 --key theme 2>/dev/null || echo '<unavailable>')"
if [ "$(kreadconfig6 --file kwinrc --group org.kde.kdecoration2 --key library 2>/dev/null)" = "$plugin_id" ]; then
    ok 'KWin is configured to use the Accent Outline plugin'
else
    warn "kwinrc does not select $plugin_id"
fi
printf 'outline width:  %s\n' "$(read_outline_entry OutlineWidth '8 (schema default)')"
printf 'rounded corners: %s\n' "$(read_outline_entry RoundedCorners 'true (schema default)')"
printf 'corner radius:   %s\n' "$(read_outline_entry CornerRadius '8 (schema default)')"
printf 'custom accent:   %s\n' "$(read_outline_entry UseCustomAccent 'false (schema default)')"
printf 'custom color:    %s\n' "$(read_outline_entry CustomAccentColor '61,174,233 (schema default)')"

# ------------------------------------------------------- Qt plugin path validity
# Qt does not expand %h in QT_PLUGIN_PATH. A literal %h, or any relative path,
# silently disables user plugin discovery, and nothing else reports it.
section "Qt plugin path"
check_plugin_path() {
    local label=$1 value=$2
    case $value in
        '')
            bad "$label is unset"
            ;;
        *%h*)
            bad "$label contains a literal %h: $value"
            hint 'Qt does not expand %h here; use an absolute path'
            ;;
        /*) ok "$label = $value" ;;
        *)
            bad "$label is not absolute: $value"
            hint "expected an absolute path such as $plugin_root"
            ;;
    esac
}

service_env() {
    systemctl --user show "$1" -p Environment --value 2>/dev/null |
        tr ' ' '\n' | sed -n 's/^QT_PLUGIN_PATH=//p' | head -1
}

check_plugin_path "plasma-kwin_wayland QT_PLUGIN_PATH" "$(service_env plasma-kwin_wayland.service)"
check_plugin_path "plasma-plasmashell QT_PLUGIN_PATH" "$(service_env plasma-plasmashell.service)"

manager_env=$(systemctl --user show-environment 2>/dev/null | sed -n 's/^QT_PLUGIN_PATH=//p' | head -1)
if [ -z "$manager_env" ] || [ "${manager_env#%h}" != "$manager_env" ]; then
    warn "systemd user manager QT_PLUGIN_PATH is '${manager_env:-unset}'"
    hint 'ksmserver re-imports its own environment on restart, so the manager value drifts'
    hint 'harmless while the per-service drop-ins are in place'
else
    ok "systemd user manager QT_PLUGIN_PATH = $manager_env"
fi

case "${QT_PLUGIN_PATH-}" in
    '') warn 'this shell has no QT_PLUGIN_PATH; apps launched from it will not see user plugins' ;;
    /*) ok "this shell QT_PLUGIN_PATH = $QT_PLUGIN_PATH" ;;
    *) warn "this shell QT_PLUGIN_PATH is not absolute: $QT_PLUGIN_PATH" ;;
esac

section "Plugin path durability"
for unit in plasma-kwin_wayland.service plasma-plasmashell.service; do
    dropin="$HOME/.config/systemd/user/$unit.d/90-accent-outline-plugin.conf"
    if [ -f "$dropin" ] && grep -q 'QT_PLUGIN_PATH=/' "$dropin"; then
        ok "drop-in present for $unit"
    else
        bad "no absolute-path drop-in for $unit"
        hint "create $dropin with: [Service] / Environment=QT_PLUGIN_PATH=$plugin_root"
    fi
done
if [ -f "$kcm_dropin" ] && grep -q 'QT_PLUGIN_PATH=/' "$kcm_dropin"; then
    ok "login-time default present: $kcm_dropin"
else
    warn "login-time default missing or not absolute: $kcm_dropin"
    hint 'without it a fresh login starts with no user plugin path'
fi

# -------------------------------------------------------------- session integrity
# pam_kwallet5 leaks one ksecretd --pam-login per session on this build. Each
# stale helper pins its logind session in "closing" forever, and the seat then
# cannot complete DRM-master negotiation, so the next KWin start blocks with no
# log output at all.
section "Session integrity"
stuck_sessions=""
for s in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}'); do
    [ "$(loginctl show-session "$s" -p State --value 2>/dev/null)" = "closing" ] && stuck_sessions="$stuck_sessions $s"
done
stale_helpers=""
for p in $(pgrep -x ksecretd 2>/dev/null); do
    sess=$(sed -n 's|.*session-\([0-9]*\)\.scope.*|\1|p' "/proc/$p/cgroup" 2>/dev/null)
    [ -z "$sess" ] && continue
    [ "$(loginctl show-session "$sess" -p State --value 2>/dev/null)" = "active" ] && continue
    stale_helpers="$stale_helpers $p"
done

if [ -n "$stale_helpers" ]; then
    bad "stale ksecretd helper(s) from dead sessions:$stale_helpers"
    hint 'these pin their sessions in "closing" and block the next KWin start'
    hint 'reap with: for p in $(pgrep -x ksecretd); do s=$(sed -n "s|.*session-\([0-9]*\)\.scope.*|\1|p" /proc/$p/cgroup); [ "$(loginctl show-session "$s" -p State --value)" = active ] || kill -TERM $p; done'
fi
if [ -n "$stuck_sessions" ]; then
    bad "logind session(s) stuck in closing:$stuck_sessions"
    hint 'after reaping the helpers above these are removed automatically'
else
    ok 'no logind sessions stuck in "closing"'
fi
if [ -z "$stale_helpers" ] && [ -z "$stuck_sessions" ]; then
    ok 'no leaked session debris (safe to restart the compositor)'
fi

# ------------------------------------------------------------------------ KWin
section "KWin"
printf 'service: %s\n' "$(systemctl --user is-active plasma-kwin_wayland.service 2>/dev/null || echo unknown)"
support_info=$(busctl --user call org.kde.KWin /KWin org.kde.KWin supportInformation 2>/dev/null || true)
if printf '%s' "$support_info" | grep -q "Plugin: $plugin_id"; then
    ok "KWin loaded $plugin_id"
else
    bad "KWin has NOT loaded $plugin_id"
    printf '%s\n' "$support_info" | tr '\\' '\n' | sed -n 's/^n*Plugin: /         loaded instead: /p' | head -3
fi
if printf '%s\n' "$support_info" | tr '\\' '\n' | grep -q 'Enabled: 1'; then
    ok 'at least one output is enabled'
else
    bad 'no enabled output; the compositor is not usable'
fi
if [ -z "$support_info" ]; then
    bad 'KWin did not answer on D-Bus (hung compositor?)'
    hint 'run tools/kwin-restart instead of restarting the unit by hand'
fi

# ------------------------------------------------------------------ wallpaper hue
section "Wallpaper accent"
accent=$(qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.color 2>/dev/null || true)
if [ -n "$accent" ]; then
    ok "PlasmaShell.color: $accent"
else
    warn 'PlasmaShell.color unavailable; the plugin falls back to the palette accent'
fi

# --------------------------------------------------------------------------- KCM
section "KCM"
# kcmshell6 only searches the plasma/kcms* namespaces, so a bare id such as
# "kcm_accentoutline" cannot resolve. The namespace-relative form is what KWin
# and the installed desktop entry use.
if [ -f "$kcm_file" ]; then
    if QT_QPA_PLATFORM=offscreen QT_PLUGIN_PATH="$plugin_root" \
        kcmshell6 --smoke-test "$kcm_namespace/$kcm_id" >/dev/null 2>&1; then
        ok "resolves and loads as $kcm_namespace/$kcm_id"
    else
        bad "does not resolve as $kcm_namespace/$kcm_id"
        hint 'this is the form System Settings and the desktop entry rely on'
    fi
    if QT_QPA_PLATFORM=offscreen QT_PLUGIN_PATH="$plugin_root" \
        kcmshell6 --smoke-test kcm_about-distro >/dev/null 2>&1; then
        ok 'kcmshell6 itself is functional'
    fi
else
    warn 'KCM module missing, so the settings cannot be opened'
fi

desktop_entry="$HOME/.local/share/applications/$kcm_id.desktop"
if [ -f "$desktop_entry" ]; then
    if grep -q "Exec=kcmshell6 $kcm_namespace/$kcm_id" "$desktop_entry"; then
        ok "desktop entry uses a resolvable module id"
    else
        bad 'desktop entry uses an unresolvable module id'
        hint "expected: Exec=kcmshell6 $kcm_namespace/$kcm_id"
    fi
else
    warn "no launcher installed at $desktop_entry"
fi

# ------------------------------------------------------------ recent log messages
section "Recent decoration messages"
# eglInitialize/EGL_NOT_INITIALIZED and host-portal registration messages appear
# on every start and are benign; filtering them keeps real problems visible.
recent=$(journalctl --user -u plasma-kwin_wayland.service --since '-15 minutes' --no-pager 2>/dev/null |
    grep -Ei 'accent|decoration|Could not locate decoration' |
    grep -Eiv 'eglInitialize|EGL_NOT_INITIALIZED|host portal' | tail -15)
if [ -n "$recent" ]; then
    printf '%s\n' "$recent" | sed 's/^/  /'
else
    echo '  (nothing in the last 15 minutes)'
fi
if journalctl --user -u plasma-kwin_wayland.service --since '-15 minutes' --no-pager 2>/dev/null |
    grep -q 'Could not locate decoration'; then
    bad 'KWin reported it could not locate the decoration plugin'
fi

# ------------------------------------------------------------------------- verdict
section "Verdict"
printf 'failures=%d warnings=%d\n' "$failures" "$warnings"
if [ "$failures" -gt 0 ]; then
    echo 'RESULT: problems found (see [FAIL] above).'
    exit 1
fi
if [ "$warnings" -gt 0 ]; then
    echo 'RESULT: usable, with warnings.'
    exit 0
fi
echo 'RESULT: Accent Outline is installed, discoverable and active.'
exit 0
